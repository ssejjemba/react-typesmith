{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "outDir": "dist",
      "rootDir": "src",
      "moduleResolution": "node",
      "lib": ["ESNext", "DOM"]
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
  }